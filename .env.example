# Database (Turso)
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_TOKEN="your-turso-auth-token"

# Better Auth
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-generated-secret"

# OAuth proxy
# Shared across production and previews, separate from each app's AUTH_SECRET.
OAUTH_PROXY_SECRET=""

# OAuth Providers (Discord)
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"

# Development URLs
LOCAL_URL="http://localhost:3000"  # or https://your-tunnel-url.com for OAuth
EXPO_PUBLIC_API_URL="http://localhost:3000"  # or https://your-tunnel-url.com for OAuth

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_API_KEY="your-posthog-api-key"
EXPO_PUBLIC_POSTHOG_HOST="[REDACTED]"

# Optional testing flags
ALLOW_SELF_MESSAGES="false"
ENABLE_BACKGROUND_UPLOAD_TEST_PAGE="false"
EXPO_PUBLIC_ALLOW_SELF_MESSAGES="false"
EXPO_PUBLIC_ENABLE_BACKGROUND_UPLOAD_TEST_PAGE="false"

# Optional: Discord webhook that pings when a report is submitted (category and ID only).
# Set it for Production only in Vercel so preview reports stay quiet.
# DISCORD_REPORTS_WEBHOOK_URL=""
# Required for daily retention/file cleanup. Store a random secret in deployment config.
# CRON_SECRET=""
# Approved policy: docs/abuse-retention-assessment.md. Configure a dedicated key.
# Use a dedicated random secret, never AUTH_SECRET. Do not rotate with active records.
# ABUSE_ENFORCEMENT_KEY=""
# ABUSE_RETENTION_POLICY_VERSION="2026-09-21.1"
